{
  "name": "commandrm",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:unit:app": "vitest --config vitest.config.ts",
    "test:unit:claude": "vitest --config vitest.config.ts --project claude",
    "test:unit:functions": "vitest --config vitest.config.ts --project functions",
    "dev": "vite --force",
    "dev:demo": "vite --config vite.demo.config --force",
    "build": "tsc && vite build",
    "build:e2e": "vite build --mode e2e",
    "build:demo": "tsc && vite build --config vite.demo.config",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "preview": "vite preview",
    "lint:apply": "eslint **/*.{mjs,ts,tsx} --fix",
    "lint": "eslint **/*.{mjs,ts,tsx}",
    "prettier:apply": "prettier --config ./.prettierrc.json --write --list-different \"**/*.{mjs,js,json,ts,tsx,css,md,html}\"",
    "prettier": "prettier --config ./.prettierrc.json --check \"**/*.{mjs,js,json,ts,tsx,css,md,html}\"",
    "registry:build": "npx shadcn build",
    "registry:gen": "node ./scripts/generate-registry.mjs",
    "ghpages:deploy": "node ./scripts/ghpages-deploy.mjs",
    "supabase:remote:init": "node ./scripts/supabase-remote-init.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "update-changelog": "gh api 'repos/{owner}/{repo}/releases' --paginate -q '.[] | \"## \\(.tag_name) - \\(.published_at[:10])\\n\\n\\(.body)\\n\"' > CHANGELOG.md"
  },
